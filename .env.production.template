# ==========================================
# Flowise 生产环境配置模板
# 适用于腾讯云 Lighthouse 部署
# 警告：部署前必须替换所有占位符为真实值
# ==========================================

NODE_ENV=production

# ------------------ 基础配置 ------------------
PORT=3000
APP_URL=https://your-domain.com
# Host interface used for the published Flowise port. Keep localhost unless a
# containerized reverse proxy requires a private Docker bridge gateway.
FLOWISE_BIND_IP=127.0.0.1
FLOWISE_PROXY_NETWORK=lighthouse_ai_video_net

# 信任代理（Nginx 在前的反向代理场景必须设置）
TRUST_PROXY=1

# 文件上传限制
FLOWISE_FILE_SIZE_LIMIT=50mb

# ------------------ 数据库配置 ------------------
# 生产环境必须使用 PostgreSQL
POSTGRES_DB=flowise
POSTGRES_USER=flowise
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# 以下 DATABASE_* 供非 Compose 启动方式参考；docker-compose.prod.yml 会从 POSTGRES_* 映射到容器内 DATABASE_*。
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=flowise
DATABASE_USER=flowise
DATABASE_SSL=true
DATABASE_REJECT_UNAUTHORIZED=true

# ------------------ 安全认证配置 ------------------
# 生产开放管理员登录页；管理员模式会关闭注册、邀请、SSO 与验收码入口。
PUBLIC_LOGIN_ENABLED=true
ADMIN_ONLY_MODE=true

# 安全 Cookie（HTTPS 环境下必须开启）
SECURE_COOKIES=true

# JWT 密钥 — 32字节随机值（hex: 64字符）
# 生成命令: openssl rand -hex 32
JWT_AUTH_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHARS_JWT_AUTH_TOKEN_SECRET
JWT_REFRESH_TOKEN_SECRET=REPLACE_WITH_64_HEX_CHARS_JWT_REFRESH_TOKEN_SECRET

# 会话密钥 — 32字节随机值（hex: 64字符）
EXPRESS_SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS_EXPRESS_SESSION_SECRET
TOKEN_HASH_SECRET=REPLACE_WITH_64_HEX_CHARS_TOKEN_HASH_SECRET

# 既有部署必须复用当前 encryption key，禁止在容器重建时生成替代值。
# 仅全新部署可生成新的 32 字节随机值（hex: 64 字符）。
FLOWISE_SECRETKEY_OVERWRITE=REPLACE_WITH_64_HEX_CHARS_FLOWISE_SECRET

# 令牌过期时间（生产环境建议 ≤120 分钟）
JWT_TOKEN_EXPIRY_IN_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRY_IN_MINUTES=10080

# 认证令牌在重启时过期（增强安全性）
EXPIRE_AUTH_TOKENS_ON_RESTART=true

# ------------------ CORS / iframe 安全 ------------------
# CORS 来源：精确填写你的域名，禁止 *
# 格式: https://your-domain.com,https://admin.your-domain.com
CORS_ORIGINS=https://your-domain.com

# iframe 嵌入策略：仅允许同域（生产环境严格限制）
# Compose 会去掉普通 shell 引号；必须保留内部 CSP 引号，写成 "'self'"。
IFRAME_ORIGINS="'self'"

# CSP 分阶段治理：enforcement 默认保持兼容；report-only 需显式启用更严格的候选模式
# 可选值: compat, no-eval, strict-script, strict；report-only 还可设为 off
CSP_ENFORCEMENT_MODE=compat
CSP_REPORT_ONLY_MODE=off

# 跨域请求携带凭证默认关闭；仅在确有跨域 Cookie 需求且 CORS_ORIGINS 精确受控时开启
CORS_ALLOW_CREDENTIALS=false

# ------------------ 安全开关（CVE 修复）------------------
# HTTP 请求安全校验（防止 SSRF / 文件读取漏洞）
HTTP_SECURITY_CHECK=true

# 路径遍历安全（防止 ../ 攻击）
PATH_TRAVERSAL_SAFETY=true

# Custom MCP 安全校验（防止命令注入 RCE）
CUSTOM_MCP_SECURITY_CHECK=true

# Custom MCP 允许命令白名单（仅列出必需命令；留空表示禁止所有 stdio 命令）
# 如需使用 Custom MCP stdio 模式，按需添加已审查的命令：node,npx,python,python3,docker
CUSTOM_MCP_ALLOWED_COMMANDS=

# OAuth2 令牌安全校验（防止令牌窃取）
OAUTH2_SECURITY_CHECK=true

# ------------------ Provider 端点策略 ------------------
# 留空时仅允许节点内置的官方 HTTPS origin。
# 如需使用已审查的兼容网关，填写逗号分隔的 HTTPS origin（不含路径、查询或凭证）。
DEEPSEEK_BASE_URL_ALLOWLIST=
KIMI_BASE_URL_ALLOWLIST=

# ------------------ 日志与监控 ------------------
LOG_LEVEL=warn

# 日志脱敏字段（默认已包含敏感信息）
LOG_SANITIZE_BODY_FIELDS=password,pwd,pass,secret,token,apikey,api_key,accesstoken,access_token,refreshtoken,refresh_token,clientsecret,client_secret,privatekey,private_key,secretkey,secret_key,auth,authorization,credential,credentials

# ------------------ 存储配置 ------------------
STORAGE_TYPE=local
BLOB_STORAGE_PATH=/usr/src/flowise/.flowise/storage

# ------------------ 禁用遥测 ------------------
DISABLE_FLOWISE_TELEMETRY=true

# ------------------ 工具安全限制 ------------------
# 额外内置依赖白名单；默认内置安全模块已由代码提供，生产默认不扩展
TOOL_FUNCTION_BUILTIN_DEP=
ALLOW_BUILTIN_DEP=false

# 额外外部依赖白名单；生产默认不扩展，逐项安全评审后再添加
TOOL_FUNCTION_EXTERNAL_DEP=

# ------------------ Docker 构建 ------------------
# Parse-only examples. Replace FLOWISE_IMAGE with the exact manifest release id;
# production preflight rejects the all-zero Git revision below.
FLOWISE_IMAGE=flowise-chinese:git-0000000000000000000000000000000000000000
POSTGRES_IMAGE=postgres:16-alpine

PUPPETEER_SKIP_DOWNLOAD=true

# Node.js 内存限制（根据服务器内存调整）
NODE_OPTIONS=--max-old-space-size=4096

# ------------------ 邮件配置（可选）------------------
# SMTP_HOST=smtp.host.com
# SMTP_PORT=465
# SMTP_USER=smtp_user
# SMTP_PASSWORD=smtp_password
# SMTP_SECURE=true
# ALLOW_UNAUTHORIZED_CERTS=false
# SENDER_EMAIL=team@your-domain.com

# ------------------ 队列 / Redis（可选，多实例部署时启用）------------------
# MODE=queue
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# ------------------ 安全响应头（Nginx 层补充）------------------
# 以下由 Nginx 配置处理，不通过 Flowise 环境变量控制：
# - HSTS: Strict-Transport-Security: max-age=31536000; includeSubDomains
# - X-Content-Type-Options: nosniff
# - X-XSS-Protection: 1; mode=block
# - Referrer-Policy: strict-origin-when-cross-origin

# ------------------ 密钥生成参考 ------------------
# 执行以下命令生成安全密钥：
# JWT_AUTH_TOKEN_SECRET:      openssl rand -hex 32
# JWT_REFRESH_TOKEN_SECRET:   openssl rand -hex 32
# EXPRESS_SESSION_SECRET:     openssl rand -hex 32
# TOKEN_HASH_SECRET:          openssl rand -hex 32
# FLOWISE_SECRETKEY_OVERWRITE（仅全新部署）: openssl rand -hex 32
# POSTGRES_PASSWORD: openssl rand -base64 24
# REDIS_PASSWORD:  openssl rand -base64 24
