{
    "name": "flowise",
    "version": "3.1.3",
    "private": true,
    "packageManager": "pnpm@10.26.0",
    "homepage": "https://flowiseai.com",
    "workspaces": [
        "packages/*",
        "flowise",
        "ui",
        "components",
        "api-documentation"
    ],
    "scripts": {
        "build": "turbo run build",
        "build:docker": "turbo run build --filter=!@flowiseai/agentflow --filter=!@flowiseai/observe",
        "build-force": "pnpm clean && turbo run build --force",
        "dev": "turbo run dev --parallel --no-cache",
        "start": "run-script-os",
        "start:windows": "cd packages/server/bin && run start",
        "start:default": "cd packages/server/bin && ./run start",
        "start-worker": "run-script-os",
        "start-worker:windows": "cd packages/server/bin && run worker",
        "start-worker:default": "cd packages/server/bin && ./run worker",
        "user": "run-script-os",
        "user:windows": "cd packages/server/bin && run user",
        "user:default": "cd packages/server/bin && ./run user",
        "test": "turbo run test",
        "test:coverage": "turbo run test:coverage",
        "clean": "pnpm -r clean",
        "nuke": "pnpm -r nuke && rimraf node_modules .turbo",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "lint": "eslint \"**/*.{js,jsx,ts,tsx,json,md}\"",
        "lint-fix": "pnpm lint --fix",
        "quick": "pretty-quick --staged",
        "postinstall": "husky install",
        "release:manifest": "node scripts/release-manifest.mjs",
        "release:baseline": "node scripts/release-baseline.mjs",
        "release:slim-probe": "bash scripts/verify-runtime-without-compilers.sh",
        "metadata:i18n:extract": "node scripts/metadata-i18n/extract.mjs",
        "metadata:i18n:validate": "node scripts/metadata-i18n/validate.mjs",
        "test:release": "node --test scripts/release-manifest.test.mjs scripts/release-baseline.test.mjs scripts/publish-verified-image.test.mjs scripts/deployment-bundle.test.mjs && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest scripts/test_flowise_production_release.py scripts/integration/test_flowise_legacy_bootstrap_docker.py",
        "migration:create": "pnpm typeorm migration:create",
        "changeset": "changeset",
        "changeset:version": "changeset version"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,md}": "eslint --fix"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.0",
        "@babel/preset-env": "^7.19.4",
        "@babel/preset-typescript": "7.18.6",
        "@types/express": "^4.17.13",
        "@typescript-eslint/typescript-estree": "^7.13.1",
        "eslint": "^8.24.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-config-react-app": "^7.0.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-markdown": "^3.0.0",
        "eslint-plugin-prettier": "^3.4.0",
        "eslint-plugin-react": "^7.26.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-unused-imports": "^2.0.0",
        "husky": "^8.0.1",
        "js-yaml": "4.3.0",
        "kill-port": "2.0.1",
        "lint-staged": "^13.0.3",
        "prettier": "^2.7.1",
        "pretty-quick": "^3.1.3",
        "rimraf": "^3.0.2",
        "run-script-os": "^1.1.6",
        "turbo": "1.10.16",
        "typescript": "^5.4.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "faiss-node",
            "sqlite3"
        ],
        "overrides": {
            "@xmldom/xmldom": "0.8.13",
            "@babel/plugin-transform-modules-systemjs": "7.29.4",
            "@mapbox/node-pre-gyp@1.0.11": "2.0.3",
            "@ladle/react": "5.1.1",
            "@mem0/community>@langchain/community": "0.3.59",
            "@langchain/community@0.3.59>langchain": "0.3.37",
            "@modelcontextprotocol/server-slack>@modelcontextprotocol/sdk": "1.29.0",
            "adm-zip": "0.6.0",
            "prebuild-install": "7.1.3",
            "axios": "1.18.1",
            "basic-ftp": "5.3.1",
            "body-parser": "2.0.2",
            "braces": "3.0.3",
            "brace-expansion@1.1.11": "1.1.16",
            "brace-expansion@2.0.1": "2.1.2",
            "convict": "6.2.5",
            "cross-spawn": "7.0.6",
            "dompurify": "3.4.12",
            "ejs@3.1.10": "5.0.2",
            "fast-xml-builder": "1.1.7",
            "fast-xml-parser@>=4.1.3 <4.5.5": "4.5.5",
            "fast-xml-parser@>=5.0.0 <5.5.6": "5.5.6",
            "form-data": "4.0.6",
            "fast-uri": "3.1.4",
            "geoip-lite@1.4.10": "2.0.3",
            "glob-parent": "6.0.2",
            "gulp@4.0.2": "5.0.1",
            "handlebars": "4.7.9",
            "http-proxy-middleware": "3.0.3",
            "hono": "4.12.25",
            "immutable": "4.3.9",
            "js-yaml": "4.3.0",
            "json5": "2.2.3",
            "jws@3.2.2": "3.2.3",
            "jws@4.0.0": "4.0.1",
            "lodash": "4.18.1",
            "lodash-es": "4.18.1",
            "linkify-it": "5.0.2",
            "langsmith": "0.6.0",
            "minimatch@3.1.2": "3.1.4",
            "minimatch@5.1.6": "5.1.8",
            "minimatch@>=9.0.0 <9.0.7": "9.0.7",
            "node-gyp@8.4.1": "11.5.0",
            "nth-check": "2.1.1",
            "path-to-regexp": "0.1.13",
            "picomatch@2.3.1": "2.3.2",
            "picomatch@4.0.3": "4.0.5",
            "@playwright/test": "1.61.1",
            "playwright": "1.61.1",
            "postcss": "8.5.22",
            "prismjs": "1.29.0",
            "rollup": "4.62.2",
            "semver": "7.7.1",
            "seroval": "1.5.6",
            "set-value": "4.1.0",
            "sha.js": "2.4.12",
            "sharp": "0.35.3",
            "solid-js": "1.9.7",
            "swagger-jsdoc": "6.3.0",
            "@modelcontextprotocol/server-postgres>@modelcontextprotocol/sdk": "1.29.0",
            "@mapbox/node-pre-gyp>tar": "7.5.19",
            "tar": "7.5.19",
            "tar-fs": "3.1.3",
            "tmp": "0.2.7",
            "undici@>=6 <7": "6.27.0",
            "underscore": "1.13.8",
            "validator": "13.15.35",
            "unset-value": "2.0.1",
            "webpack-dev-middleware": "7.4.2",
            "ws": "8.21.1",
            "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
            "uuid": "^10.0.0",
            "request>uuid": "^3.4.0"
        }
    },
    "engines": {
        "node": "24.18.0",
        "pnpm": "10.26.0"
    },
    "resolutions": {
        "@anthropic-ai/sdk": "^0.73.0",
        "@google/generative-ai": "^0.24.0",
        "@grpc/grpc-js": "1.14.4",
        "@langchain/core": "1.1.20",
        "@qdrant/openapi-typescript-fetch": "1.2.6",
        "openai": "6.19.0",
        "protobufjs": "7.6.1",
        "uuid": "^10.0.0"
    },
    "eslintIgnore": [
        "**/dist",
        "**/node_modules",
        "**/build",
        "**/package-lock.json"
    ],
    "prettier": {
        "printWidth": 140,
        "singleQuote": true,
        "jsxSingleQuote": true,
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "endOfLine": "auto"
    },
    "babel": {
        "presets": [
            "@babel/preset-typescript",
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "node": "current"
                    }
                }
            ]
        ]
    }
}
